# Copie para .env (fora do git, ver .gitignore) e preencha no servidor.
# A chave nunca vai para o frontend nem para o repositório.
OPENROUTER_API_KEY=
# Modelo da OpenRouter usado na interpretação. Trocar o modelo muda custo e texto.
LLM_MODELO=openai/gpt-4o-mini
# Origem do frontend liberada no CORS.
FRONTEND_ORIGEM=http://localhost:5173
